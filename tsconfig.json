{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noEmitOnError": true,
        "verbatimModuleSyntax": true,
        "types": [
            "node"
        ],
        /* "noCheck": true  //Раскомментрируйте, если хотите запустить тесты */
    },
    "include": [
        "src/**/*.ts"
    ]
}